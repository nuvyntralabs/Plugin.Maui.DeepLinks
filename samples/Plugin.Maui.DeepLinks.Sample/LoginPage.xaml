<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plugin.Maui.DeepLinks.Sample.LoginPage"
             Title="Sign in">
    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="This link requires a signed-in user." />
        <Label x:Name="PendingLabel" LineBreakMode="WordWrap" />
        <Button Text="Complete sign in and restore link" Clicked="OnSignIn" />
    </VerticalStackLayout>
</ContentPage>
